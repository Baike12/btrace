next-env.d.ts

# production
/build

# Rust build artifacts
langfuse-rs/target/

# Playwright browser cache
.playwright-cli/
.playwright-mcp/

# claude worktrees
.claude/worktrees

# idea
.idea

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env*
!.env.dev.example
!.env.prod.example
!.env.test.example
# The Rust backend's own template. `.env*` above matches it, so without this
# negation the file that documents the backend's required variables can never
# be committed.
!langfuse-rs/.env.example


# vercel
.vercel

# typescript
*.tsbuildinfo

# python
__pycache__/
*.py[cod]

/generated

# openapi spec that is copied during build
/public/openapi*.yml

# Ad-hoc verification screenshots dumped at the repo root. Kept on disk, but
# they are not project assets and nothing references them.
/*.png

